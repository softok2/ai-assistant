APP_NAME="AI Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Session (obligatorio para el iframe cross-site) ────────────────────────────
# Producción (https): SECURE_COOKIE=true + SAME_SITE=none
# Local por http:      SECURE_COOKIE=false + SAME_SITE=lax
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Correo (envío del reporte ejecutivo) ───────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
OCTANE_SERVER=frankenphp

# ─── IA (OpenAI vía Laravel AI SDK · Responses API) ─────────────────────────────
OPENAI_API_KEY="<openai-api-key>"
OPENAI_MODEL="gpt-4.1-mini"
# Clave del proyecto de OpenAI de cada club. El store de un club
# (OPENAI_VECTOR_STORE_*) debe vivir en el proyecto de su clave. Sin clave
# propia el club usa OPENAI_API_KEY.
OPENAI_API_KEY_CCM=""
OPENAI_API_KEY_VALLEALTO=""
# Un vector store por club (RAG · File Search). El store actual es el de ccm.
OPENAI_VECTOR_STORE_CCM="<openai-vector-store-id>"
OPENAI_VECTOR_STORE_VALLEALTO="<openai-vector-store-id>"

# ─── Autenticación externa (enlace firmado desde el panel del club) ─────────────
# Secret HMAC compartido con el club. IDÉNTICO en ambos lados (en ccm: SOFTOK2_AI_CHAT_SECRET).
# Genera uno con: openssl rand -hex 32
CCM_SIGNATURE_SECRET="<64-char-random-hex>"
VALLEALTO_SIGNATURE_SECRET="<64-char-random-hex>"
# en vallealto: SOFTOK2_AI_CHAT_SECRET
# Orígenes permitidos a embeber la app en un iframe, separados por espacio (CSP).
FRAME_ANCESTORS="https://ccm-admin-api.test https://vallealto-admin-api.test"

# ─── Reporte ejecutivo en PDF (Browsershot / Chromium) ──────────────────────────
# Ruta al binario de Chrome/Chromium. Node debe estar en el PATH.
BROWSERSHOT_CHROME_PATH=""

# ─── Fuentes de conocimiento por club (config/knowledge.php) ────────────────────
# ccm (transición): reportes .md del MDS de Pentaho.
SOFTOK2MDS_BASE_URL="https://softok2mds.example.com/api/"
SOFTOK2MDS_USERNAME=""
SOFTOK2MDS_PASSWORD=""
SOFTOK2MDS_FILES="golf-output"
# vallealto: manifiesto de `bi:knowledge` del panel (mismas credenciales que BI_KNOWLEDGE_* allá).
VALLEALTO_KNOWLEDGE_URL="https://vallealto-admin-api.test/bi/knowledge"
VALLEALTO_KNOWLEDGE_USERNAME=""
VALLEALTO_KNOWLEDGE_PASSWORD=""
